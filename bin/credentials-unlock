#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "credentials-unlock is only supported on macOS" >&2
  exit 1
fi

if ! security show-keychain-info >/dev/null 2>&1; then
  echo "Unlocking macOS login keychain..."
  security unlock-keychain
fi

echo
echo "Credentials unlocked."
