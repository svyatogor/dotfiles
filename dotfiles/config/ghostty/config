theme = light:circadia-light.ghostty,dark:circadia-dark.ghostty

shell-integration = zsh
shell-integration-features = true
clipboard-read = allow

#background-opacity = 0.92
window-colorspace = display-p3
#background-blur = macos-glass-regular
#background-blur = 50

window-padding-balance = true
window-padding-x = 4
window-padding-y = 8

macos-titlebar-style = tabs
macos-option-as-alt = true

font-size = 13
adjust-cell-height = 20%
#font-family = Ioskeley Mono Term
font-family = Lilex

# Shift+Enter sends Escape followed by carriage return, equivalent to Alt+Enter.
keybind = shift+enter=text:\x1b\r


# Russian Phonetic layout: force Ctrl+<cyrillic> → correct control codes
keybind = ctrl+а=text:\x01
keybind = ctrl+б=text:\x02
keybind = ctrl+ц=text:\x03
keybind = ctrl+д=text:\x04
keybind = ctrl+е=text:\x05
keybind = ctrl+ф=text:\x06
keybind = ctrl+г=text:\x07
keybind = ctrl+х=text:\x08
keybind = ctrl+и=text:\x09
keybind = ctrl+к=text:\x0b
keybind = ctrl+л=text:\x0c
keybind = ctrl+н=text:\x0e
keybind = ctrl+о=text:\x0f
keybind = ctrl+п=text:\x10
keybind = ctrl+я=text:\x11
keybind = ctrl+р=text:\x12
keybind = ctrl+с=text:\x13
keybind = ctrl+т=text:\x14
keybind = ctrl+у=text:\x15
keybind = ctrl+в=text:\x16
keybind = ctrl+ш=text:\x17
keybind = ctrl+ь=text:\x18
keybind = ctrl+ы=text:\x19
keybind = ctrl+з=text:\x1a

# Outside Neovim.
# Move
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right

# Resize
keybind = performable:alt+h=resize_split:left,30
keybind = performable:alt+j=resize_split:down,30
keybind = performable:alt+k=resize_split:up,30
keybind = performable:alt+l=resize_split:right,30

# Inside Neovim.
keybind = nvim/
# Move
keybind = nvim/ctrl+h=text:\x08
keybind = nvim/ctrl+j=text:\x0a
keybind = nvim/ctrl+k=text:\x0b
keybind = nvim/ctrl+l=text:\x0c

# Resize
keybind = nvim/alt+h=esc:h
keybind = nvim/alt+j=esc:j
keybind = nvim/alt+k=esc:k
keybind = nvim/alt+l=esc:l

# Tabs: send CSI-u encoded keys so Neovim sees <C-Tab>, <C-S-Tab>, <C-1>..<C-4>.
keybind = nvim/ctrl+tab=text:\x1b[9;5u
keybind = nvim/ctrl+shift+tab=text:\x1b[9;6u
keybind = nvim/ctrl+1=text:\x1b[49;5u
keybind = nvim/ctrl+2=text:\x1b[50;5u
keybind = nvim/ctrl+3=text:\x1b[51;5u
keybind = nvim/ctrl+4=text:\x1b[52;5u
