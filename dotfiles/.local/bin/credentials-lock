#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "credentials-lock is only supported on macOS" >&2
  exit 1
fi

login_keychain=$(/usr/bin/security default-keychain -d user | sed -E 's/^[[:space:]]*"//; s/"[[:space:]]*$//')

export SSH_AUTH_SOCK="$HOME/.ssh/agent/agent.sock"
/usr/bin/ssh-add -D >/dev/null 2>&1 || true
/usr/bin/security lock-keychain "$login_keychain"

echo "SSH identities removed and login keychain locked."
