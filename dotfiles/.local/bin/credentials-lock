#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "credentials-lock is only supported on macOS" >&2
  exit 1
fi

export SSH_AUTH_SOCK="$HOME/.ssh/agent/agent.sock"
ssh-add -D >/dev/null 2>&1 || true
security lock-keychain

echo "SSH identities removed and login keychain locked."
