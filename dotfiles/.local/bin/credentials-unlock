#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "credentials-unlock is only supported on macOS" >&2
  exit 1
fi

login_keychain=$(/usr/bin/security default-keychain -d user | sed -E 's/^[[:space:]]*"//; s/"[[:space:]]*$//')

export SSH_AUTH_SOCK="$HOME/.ssh/agent/agent.sock"
"$HOME/.local/bin/ssh-agent-ensure"

if ! /usr/bin/security show-keychain-info "$login_keychain" >/dev/null 2>&1; then
  echo "Unlocking macOS login keychain..."
  /usr/bin/security unlock-keychain "$login_keychain"
fi

echo
echo "Credentials unlocked."
